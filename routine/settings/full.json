{
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "allowWrite": ["/WORK"],
      "denyWrite": ["/GUARD"]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "objects.githubusercontent.com",
        "raw.githubusercontent.com",
        "uploads.github.com"
      ]
    }
  },
  "permissions": {
    "allow": [
      "Bash",
      "Read(//WORK/**)",
      "Read(//STAGE/args.json)",
      "Read(//GUARD/plugin/**)",
      "Edit(//WORK/**)",
      "Write(//WORK/**)",
      "Workflow",
      "Agent(goals-preflight)",
      "Agent(agent-pr-pipeline:goals-preflight)",
      "Agent(pipeline-io)",
      "Agent(agent-pr-pipeline:pipeline-io)",
      "Agent(triager)",
      "Agent(agent-pr-pipeline:triager)",
      "Agent(product-reviewer)",
      "Agent(agent-pr-pipeline:product-reviewer)",
      "Agent(implementer)",
      "Agent(agent-pr-pipeline:implementer)",
      "Agent(tester)",
      "Agent(agent-pr-pipeline:tester)",
      "Agent(reviewer)",
      "Agent(agent-pr-pipeline:reviewer)",
      "Agent(arch-reviewer)",
      "Agent(agent-pr-pipeline:arch-reviewer)",
      "Agent(qa)",
      "Agent(agent-pr-pipeline:qa)",
      "Agent(fixer)",
      "Agent(agent-pr-pipeline:fixer)",
      "Agent(docs-writer)",
      "Agent(agent-pr-pipeline:docs-writer)",
      "Agent(docs-reviewer)",
      "Agent(agent-pr-pipeline:docs-reviewer)",
      "Agent(pr-opener)",
      "Agent(agent-pr-pipeline:pr-opener)",
      "Agent(bot-waiter)",
      "Agent(agent-pr-pipeline:bot-waiter)",
      "Agent(bot-answerer)",
      "Agent(agent-pr-pipeline:bot-answerer)",
      "Agent(merge-safety)",
      "Agent(agent-pr-pipeline:merge-safety)",
      "Agent(evaluator)",
      "Agent(agent-pr-pipeline:evaluator)"
    ],
    "deny": [
      "Edit(//GUARD/**)",
      "Write(//GUARD/**)",
      "NotebookEdit",
      "Agent(Explore)",
      "Agent(Plan)",
      "Agent(general-purpose)",
      "Agent(statusline-setup)",
      "Agent(claude-code-guide)",
      "Agent(output-style-setup)",
      "Agent(claude)",
      "Agent(web-fetch)",
      "Agent(land-fixer)",
      "Agent(agent-pr-pipeline:land-fixer)",
      "Agent(feedback-redactor)",
      "Agent(agent-pr-pipeline:feedback-redactor)",
      "Bash(gh pr merge*)",
      "Bash(gh release*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --tags*)",
      "Bash(git tag*)",
      "Bash(*routine-state.sh*)",
      "Bash(*land-wave.sh*)",
      "Bash(*merge-pr.sh*)",
      "Bash(*merge-wave.sh*)",
      "Bash(*release.sh*)",
      "Bash(*file-feedback.sh*)"
    ]
  }
}
